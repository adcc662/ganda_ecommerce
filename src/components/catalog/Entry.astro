---
import type { Product } from '../../lib/domain/types';
import { formatPrice, priceOf } from '../../lib/domain/money';
import { PLATFORM_SELLER } from '../../lib/sellers/constants';
import ProductFrame from './ProductFrame.astro';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const tag = priceOf(p);
const note = p.description ?? '';
const short = note.length > 170 ? `${note.slice(0, 167).trimEnd()}…` : note;
const stock = p.stockQuantity === 0 ? 'Out of stock' : p.stockQuantity <= 3 ? `${p.stockQuantity} left` : `${p.stockQuantity} in stock`;
---

<article class="entry">
  <a class="entry__photo" href={`/p/${p.slug}`} tabindex="-1" aria-hidden="true">
    <ProductFrame name={p.name} categoryName={p.categoryName} subcategoryName={p.subcategoryName} imageUrl={p.imageUrls[0]} />
  </a>
  <div class="entry__body">
    <div class="entry__head">
      <h3><a href={`/p/${p.slug}`}>{p.name}</a></h3>
      <p class="price">
        {formatPrice(tag.current)}
        {tag.original && <s>{formatPrice(tag.original)}</s>}
      </p>
    </div>
    {short && <blockquote class="voice"><p>“{short}”</p></blockquote>}
    <p class="meta">
      {`Sold by ${PLATFORM_SELLER} · ${p.subcategoryName} · `}<span
        class:list={[{ low: p.stockQuantity > 0 && p.stockQuantity <= 3, out: p.stockQuantity === 0 }]}>{stock}</span>
    </p>
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: minmax(120px, 200px) 1fr;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-top: 1px solid var(--bark-rule);
  }
  .entry__photo {
    display: block;
    text-decoration: none;
    transition: opacity 200ms var(--ease-out);
  }
  .entry:hover .entry__photo {
    opacity: 0.85;
  }
  .entry__body {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-width: 0;
  }
  .entry__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }
  h3 {
    font-size: var(--step-1);
    font-weight: 750;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .price {
    font-size: var(--step-1);
  }
  .low {
    color: var(--rust);
    font-weight: 600;
  }
  .out {
    color: var(--ember);
    font-weight: 600;
  }
  @media (max-width: 520px) {
    .entry {
      grid-template-columns: 112px 1fr;
      gap: var(--space-4);
    }
    .entry__head {
      flex-direction: column;
      gap: var(--space-1);
    }
    .voice {
      font-size: var(--step--1);
    }
  }
</style>
