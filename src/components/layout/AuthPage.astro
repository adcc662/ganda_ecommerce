---
import Base from '../../layouts/Base.astro';

interface Props {
  title: string;
  lede: string;
}
const { title, lede } = Astro.props;
---

<Base title={title}>
  <div class="page auth-page">
    <div class="auth-page__intro">
      <h1>{title}</h1>
      <p>{lede}</p>
      <blockquote class="voice">
        <p>“Write it up the way you would describe it to a friend.”</p>
        <footer>How every Ganda entry starts</footer>
      </blockquote>
    </div>
    <div class="pane auth-page__form">
      <slot />
    </div>
  </div>
</Base>

<style>
  .auth-page {
    display: grid;
    grid-template-columns: 1fr minmax(320px, 440px);
    gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-8);
  }
  .auth-page__intro {
    display: grid;
    gap: var(--space-4);
    max-width: 46ch;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 820;
    letter-spacing: -0.03em;
  }
  .auth-page__intro > p {
    color: var(--lichen);
  }
  .voice {
    margin-top: var(--space-5);
  }
  .auth-page__form {
    padding: var(--space-6);
  }
  @media (max-width: 820px) {
    .auth-page {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-block: var(--space-6);
    }
    .voice {
      display: none;
    }
    .auth-page__form {
      padding: var(--space-5);
    }
  }
</style>
