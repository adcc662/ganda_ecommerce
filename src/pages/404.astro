---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="page gone">
    <h1>That entry is not in the catalog</h1>
    <p>It may have sold, or the seller took it down. Search for something like it, or browse everything for sale.</p>
    <a class="btn btn--act" href="/">Browse everything</a>
  </div>
</Base>

<style>
  .gone {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-block: var(--space-8);
    max-width: 60ch;
  }
  h1 {
    font-size: var(--step-4);
  }
  p {
    color: var(--lichen);
  }
</style>
