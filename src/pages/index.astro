---
import Base from '../layouts/Base.astro';
import SectionIndex from '../components/catalog/SectionIndex.astro';
import CatalogHead from '../components/catalog/CatalogHead.astro';
import EntryList from '../components/catalog/EntryList.astro';
import Unavailable from '../components/catalog/Unavailable.astro';
import { load } from '../lib/api/server';
import { countBySection, pluralize, productsIn } from '../lib/domain/sections';

const PER_SECTION = 4;

const { data, error } = await load(async (api) => {
  const [categories, products] = await Promise.all([api.categories(), api.activeProducts()]);
  return { categories, products };
});
const counts = data ? countBySection(data.products) : new Map<string, number>();
const filed = data
  ? data.categories
      .map((category) => ({ category, entries: productsIn(data.products, category) }))
      .filter((s) => s.entries.length > 0)
  : [];
---

<Base>
  {
    error || !data ? (
      <Unavailable message={error?.message ?? 'Try again in a moment.'} />
    ) : (
      <>
        <SectionIndex categories={data.categories} counts={counts} />
        <div class="page">
          <CatalogHead
            title="Everything for sale"
            lede={`${pluralize(data.products.length, 'entry', 'entries')} filed under ${pluralize(filed.length, 'section')}, quoted the way they were listed.`}
          />

          {filed.length === 0 && (
            <div class="empty">
              <h2>Nothing listed yet</h2>
              <p>Be the first: anything you own or make can go in the catalog.</p>
              <a class="btn btn--act" href="/sell">Add your listing</a>
            </div>
          )}

          {filed.map(({ category, entries }) => (
            <section class="filed" aria-labelledby={`s-${category.slug}`}>
              <header class="filed__head">
                <h2 id={`s-${category.slug}`}>
                  <a href={`/section/${category.slug}`}>{category.name}</a>
                </h2>
                <ul class="filed__subs">
                  {category.subcategories.map((s) => (
                    <li><a href={`/section/${category.slug}?sub=${s.slug}`}>{s.name}</a></li>
                  ))}
                </ul>
                <a class="filed__all" href={`/section/${category.slug}`}>
                  {entries.length > PER_SECTION ? `All ${entries.length} in ${category.name}` : pluralize(entries.length, 'entry', 'entries')}
                </a>
              </header>
              <EntryList products={entries.slice(0, PER_SECTION)} label={`${category.name}, newest entries`} />
            </section>
          ))}

          <section class="invite" aria-labelledby="invite-title">
            <div>
              <h2 id="invite-title">Got something worth selling?</h2>
              <p>Write it up the way you would describe it to a friend. Your words become the entry buyers read.</p>
            </div>
            <a class="btn btn--act" href="/sell">Add your listing</a>
          </section>
        </div>
      </>
    )
  }
</Base>

<style>
  .empty {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding-block: var(--space-7);
    border-top: 1px solid var(--bark-rule);
  }
  .filed + .filed {
    margin-top: var(--space-7);
  }
  .filed__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--bark-rule);
    margin-bottom: calc(var(--space-1) * -1);
  }
  .filed__head h2 {
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.025em;
  }
  .filed__head h2 a {
    text-decoration: none;
  }
  .filed__head h2 a:hover {
    color: var(--goldenrod);
  }
  .filed__subs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: var(--step--1);
  }
  .filed__subs a {
    color: var(--lichen);
    text-decoration: none;
  }
  .filed__subs a:hover {
    color: var(--ash);
    text-decoration: underline;
  }
  .filed__all {
    margin-left: auto;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--goldenrod);
    text-decoration: none;
  }
  .filed__all:hover {
    text-decoration: underline;
  }
  .invite {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--bark-raised);
    border-radius: var(--radius);
  }
  .invite h2 {
    font-size: var(--step-3);
    font-weight: 780;
    margin-bottom: var(--space-2);
  }
  .invite p {
    max-width: 56ch;
  }
  @media (max-width: 640px) {
    .filed__all {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
