---
import { actions } from 'astro:actions';
import AuthPage from '../components/layout/AuthPage.astro';
import { Field, Notice, fieldErrorsOf, messageOf } from '../components/islands/ui';

// A plain form posting to the action: works without JavaScript. Astro runs the action and renders this page with its result.
const result = Astro.getActionResult(actions.auth.forgotPassword);
const sent = result?.data?.sent === true;
const invalid = result?.data?.invalid ?? null;
const fields = invalid ? invalid.fieldErrors : fieldErrorsOf(result?.error);
const error = invalid ? invalid.message : result?.error ? messageOf(result.error) : '';
---

<AuthPage title="Forgot your password?" lede="Tell us the email you log in with and we will send you a link to choose a new password.">
  {
    sent ? (
      <div class="reset">
        <Notice tone="ok">If an account uses that email, a reset link is on its way. It works once and expires in 30 minutes.</Notice>
        <p class="meta">
          No email after a few minutes? Check your spam folder or <a href="/forgot-password">send another link</a>.
        </p>
      </div>
    ) : (
      <form class="reset" method="POST" action={actions.auth.forgotPassword}>
        {error && <Notice tone="error">{error}</Notice>}
        <Field label="Email" error={fields.email}>
          <input class="input" name="email" type="email" autocomplete="email" required aria-invalid={fields.email ? 'true' : undefined} />
        </Field>
        <button class="btn btn--act btn--block">Send reset link</button>
        <p class="meta">
          Remembered it? <a href="/login">Log in</a>
        </p>
      </form>
    )
  }
</AuthPage>

<style>
  .reset {
    display: grid;
    gap: var(--space-4);
  }
</style>
