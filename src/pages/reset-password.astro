---
import { actions } from 'astro:actions';
import AuthPage from '../components/layout/AuthPage.astro';
import { Field, Notice, fieldErrorsOf, messageOf } from '../components/islands/ui';

// The emailed link carries a single-use token in the query string: keep it out of Referer headers and caches.
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('Cache-Control', 'no-store');

const result = Astro.getActionResult(actions.auth.resetPassword);
const done = result?.data?.reset === true;
if (done) {
  // The action ended the session, but middleware read the user before it ran: render the header logged out.
  Astro.locals.user = null;
  Astro.locals.cartCount = null;
}
const invalid = result?.data?.invalid ?? null;
const fields = invalid ? invalid.fieldErrors : fieldErrorsOf(result?.error);
const error = invalid ? invalid.message : result?.error ? messageOf(result.error) : '';
const token = Astro.url.searchParams.get('token') ?? '';
// Post back to this URL with the token kept in it, so the form still has the token if it re-renders with an error.
const target = new URL(String(actions.auth.resetPassword), Astro.url);
if (token) target.searchParams.set('token', token);
const formAction = target.pathname + target.search;
const tokenRejected = result?.error?.code === 'BAD_REQUEST' && !fields.newPassword;
---

<AuthPage title="Choose a new password" lede="Pick a password you have not used here before. Once it is saved, every device that was logged in is logged out.">
  {
    done ? (
      <div class="reset">
        <Notice tone="ok">Your password is changed. Log in with the new one.</Notice>
        <a class="btn btn--act btn--block" href="/login">Log in</a>
      </div>
    ) : tokenRejected || (!token && !result) ? (
      <div class="reset">
        <Notice tone="error">{tokenRejected ? error : 'This reset link is incomplete.'} Links work once and expire after 30 minutes.</Notice>
        <a class="btn btn--act btn--block" href="/forgot-password">Send a new link</a>
      </div>
    ) : (
      <form class="reset" method="POST" action={formAction}>
        {error && <Notice tone="error">{error}</Notice>}
        <input type="hidden" name="token" value={token || undefined} />
        <Field label="New password" error={fields.newPassword ?? fields.token} hint="At least 8 characters.">
          <input
            class="input"
            name="newPassword"
            type="password"
            autocomplete="new-password"
            minlength="8"
            required
            aria-invalid={fields.newPassword ? 'true' : undefined}
          />
        </Field>
        <button class="btn btn--act btn--block">Save new password</button>
      </form>
    )
  }
</AuthPage>

<style>
  .reset {
    display: grid;
    gap: var(--space-4);
  }
</style>
